{
  "manifest_version": 3,
  "name": "YouTube Hide Progress",
  "version": "1.4",
  "description": "Stop getting spoiled by youtube video timers.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-hide-progress@local",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icons/icon-on.svg",
    "96": "icons/icon-on.svg"
  },
  "action": {
    "default_title": "Hide YouTube timers: click to turn on/off",
    "default_icon": "icons/icon-on.svg"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["hide.css"],
      "js": ["toggle.js", "jump.js", "thumbtime.js"],
      "run_at": "document_start"
    }
  ]
}
